rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function authorized() {
      return signedIn()
        && exists(/databases/$(database)/documents/authorizedUsers/$(request.auth.uid));
    }
    function admin() {
      return authorized()
        && get(/databases/$(database)/documents/authorizedUsers/$(request.auth.uid)).data.role == 'admin';
    }
    function validEvent() {
      return request.resource.data.keys().hasOnly([
          'id','name','dateFrom','dateTo','cat','note','repeat','visibility',
          'ownerUid','visibleTo','createdAt','createdBy','updatedAt','updatedBy',
          'deletedAt','deletedBy'
        ])
        && request.resource.data.id is string
        && request.resource.data.id.matches('^u_[A-Za-z0-9_-]+$')
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 200
        && request.resource.data.dateFrom is string
        && request.resource.data.dateFrom.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (request.resource.data.dateTo == null || request.resource.data.dateTo is string)
        && request.resource.data.cat is string
        && (request.resource.data.note == null
            || request.resource.data.note is string && request.resource.data.note.size() <= 2000)
        && request.resource.data.repeat in ['none','yearly']
        && request.resource.data.visibility in ['all','private','selected']
        && request.resource.data.ownerUid is string
        && request.resource.data.createdAt is string
        && request.resource.data.createdBy is string
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedBy is string
        && (request.resource.data.deletedAt == null || request.resource.data.deletedAt is string)
        && (request.resource.data.deletedBy == null || request.resource.data.deletedBy is string);
    }

    // Původní dokumenty bez visibility zůstávají čitelné a aplikace je považuje
    // za společné. Každý nový nebo upravený dokument už projde validací.
    match /events/{eventId} {
      allow read: if authorized();
      allow create, update: if authorized() && validEvent()
        && request.resource.data.visibility == 'all'
        && eventId == request.resource.data.id;
      allow delete: if authorized();
    }

    match /users/{userId}/privateEvents/{eventId} {
      allow read: if authorized() && request.auth.uid == userId;
      allow create, update: if authorized() && request.auth.uid == userId
        && validEvent()
        && request.resource.data.visibility == 'private'
        && request.resource.data.ownerUid == userId
        && eventId == request.resource.data.id;
      allow delete: if authorized() && (request.auth.uid == userId || admin());
    }

    match /restrictedEvents/{eventId} {
      allow read: if authorized() && request.auth.uid in resource.data.visibleTo;
      allow create: if authorized() && validEvent()
        && request.resource.data.visibility == 'selected'
        && request.resource.data.ownerUid == request.auth.uid
        && request.auth.uid in request.resource.data.visibleTo
        && eventId == request.resource.data.id;
      allow update: if authorized() && validEvent()
        && (resource.data.ownerUid == request.auth.uid || admin())
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.ownerUid in request.resource.data.visibleTo
        && request.resource.data.visibility == 'selected';
      allow delete: if authorized() && (resource.data.ownerUid == request.auth.uid || admin());
    }

    match /categories/{categoryId} {
      allow read: if authorized();
      allow create: if authorized()
        && request.resource.data.id == categoryId
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if authorized()
        && (resource.data.createdBy == request.auth.uid || admin())
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if false;
    }

    match /userSettings/{userId} {
      allow read, create, update, delete: if authorized() && request.auth.uid == userId;
    }

    match /authorizedUsers/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || authorized());
      allow list: if authorized();
      allow create, delete: if admin();
      allow update: if admin() || (authorized() && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName','email','photoURL','lastLoginAt'
        ]));
    }

    match /accessRequests/{userId} {
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow read: if signedIn() && (request.auth.uid == userId || admin());
      allow delete: if admin();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
